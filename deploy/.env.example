# ===== 资产先锋 环境变量示例 =====
# 复制为 .env 后填写真实值，勿提交到 git

# --- 安全（必改）---
# 生成方式：openssl rand -hex 32
SECRET_KEY=please-change-me-to-a-long-random-string

# --- LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 无 Key 时是否启用演示模式（mock 数据跑通全流程）：true/false
LLM_MOCK=true

# --- 数据库（P0 SQLite；P2 迁 PostgreSQL）---
DATABASE_URL=sqlite:///./data/app.db

# --- 存储 ---
UPLOAD_DIR=./data/uploads
PDF_DIR=./data/pdf

# --- 数据源 ---
# 企查查 MCP 凭证（必填，否则尽调企业查询不可用）
QCC_TOKEN=
# 爱企查（可选补充源）：申请后填写 AppKey 并置 enabled=true
AIQICHA_APP_KEY=
AIQICHA_ENABLED=false

# --- 业务 ---
LPR_RATE=0.0345
MAX_CLAIMS_PER_TASK=5
